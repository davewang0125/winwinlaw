{
  "rewrites": [
    {
      "source": "/",
      "destination": "/winwinlanding/index.html"
    }
  ],
  "headers": [
    {
      "source": "/winwinlanding/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    }
  ]
}
